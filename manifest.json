{
  "manifest_version": 2,
  "name": "PDF-Direct (UT)",
  "version": "1.6.0",
  "description": "Redirects academic journal fancy PDF viewers to direct file downloads.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "*://*.acm.org/*",
    "*://*.acs.org/*",
    "*://*.cambridge.org/*",
    "*://*.ieee.org/*",
    "*://*.jstor.org/*",
    "*://*.nature.com/*",
    "*://*.oup.com/*",
    "*://*.plos.org/*",
    "*://*.pubsonline.informs.org/*",
    "*://*.pnas.org/*",
    "*://*.royalsocietypublishing.org/*",
    "*://*.sagepub.com/*",
    "*://*.science.org/*",
    "*://*.sciencedirect.com/*",
    "*://*.springer.com/*",
    "*://*.tandfonline.com/*",
    "*://*.wiley.com/*",
    "*://*.ezproxy2.utwente.nl/*",
    "*://*.ebsco.com/*",
    "*://*.oclc.org/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{60d6e3ac-5408-4049-a66d-3887555e616c}",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
    }
    }
  }
}
